<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🤖 AI Personal Focus Coach"
        android:textColor="@color/text_navy"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Powered by Groq Llama 3.3 with live screen time & hardware telemetry."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Quick Prompt Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/chipAnalyze"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#EBF3FE"
                android:text="📊 Analyze Today's Focus"
                android:textColor="@color/primary_blue"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/chipReduce"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#EBF8F2"
                android:text="💡 Reduce Distractions"
                android:textColor="@color/primary_green"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/chipPlan"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#FFF8EB"
                android:text="📅 Plan 2-Hour Study Block"
                android:textColor="#D97706"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:paddingHorizontal="12dp"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Chat Output Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_light"
        android:orientation="vertical"
        android:padding="16dp">

        <ScrollView
            android:id="@+id/svChatLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvChatLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="AI Coach: Hello! Ask me anything about your focus habits or tap a quick chip above to start analysis."
                android:textColor="@color/text_navy"
                android:textSize="14sp" />
        </ScrollView>
    </LinearLayout>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary_blue"
        android:visibility="gone" />

    <!-- Prompt Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etUserPrompt"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_light"
            android:hint="Ask your Groq AI Focus Coach..."
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_navy"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSendPrompt"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary_blue"
            android:text="Send"
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:stateListAnimator="@null" />
    </LinearLayout>

</LinearLayout>
