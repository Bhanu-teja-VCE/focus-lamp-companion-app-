<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Card.Section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:id="@+id/name" style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/seen" style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" />

        <TextView android:id="@+id/issues" style="@style/Text.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/amber" android:visibility="gone" />

        <TextView android:id="@+id/budgetLine" style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/budgetBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="1000"
            app:trackColor="@color/surface_raised"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <TextView android:id="@+id/totalLine" style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" />

        <TextView android:id="@+id/pausedHeading" style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/paused_now" />
        <LinearLayout android:id="@+id/pausedList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <TextView style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/most_used_today" />
        <LinearLayout android:id="@+id/topList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
