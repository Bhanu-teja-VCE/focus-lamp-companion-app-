<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/bottom_bar_clearance">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="8dp">

        <TextView style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/daily_budget" />
        <TextView style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/daily_budget_hint" />

        <TextView android:id="@+id/budgetValue" style="@style/Text.Number" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="24sp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/budgetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/daily_budget"
            android:stepSize="5"
            android:valueFrom="5"
            android:valueTo="240"
            app:labelBehavior="gone"
            app:thumbColor="@color/paper"
            app:trackColorActive="@color/paper"
            app:trackColorInactive="@color/surface_raised" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/blockOnBudget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/block_on_budget"
            android:textAppearance="@style/Text.Body" />

        <TextView style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/permissions" />
        <LinearLayout android:id="@+id/permissionRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/autoStart"
            style="@style/Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/oem_autostart"
            android:visibility="gone" />

        <TextView style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/coach" />
        <TextView style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/coach_key_hint" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/keyLayout"
            style="@style/Input.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/groq_key"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/keyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveKey"
            style="@style/Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/check_and_save" />

        <TextView style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/section_gap" android:text="@string/this_phone" />
        <TextView android:id="@+id/roleText" style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/switchRole"
            style="@style/Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:text="@string/switch_to_parent" />

        <TextView android:id="@+id/version" style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
