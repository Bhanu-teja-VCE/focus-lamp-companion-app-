<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp">

        <!-- Greeting Header -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back 👋"
            android:textColor="@color/text_navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Here is your digital wellbeing & focus dashboard for today."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- ========================================= -->
        <!--  SECTION: AI & Family Quick Access Banner  -->
        <!-- ========================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:baselineAligned="false">

            <!-- AI Coach Banner Card -->
            <LinearLayout
                android:id="@+id/cardAiCoachQuick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_light"
                android:padding="16dp"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 AI Focus Coach"
                    android:textSize="14sp"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat, adaptive limits & schedule parser"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

            <!-- Family Hub Banner Card -->
            <LinearLayout
                android:id="@+id/cardFamilyQuick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_light"
                android:padding="16dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👨‍👩‍👧 Family Hub"
                    android:textSize="14sp"
                    android:textColor="@color/primary_green"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parent controls & remote approvals"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- ========================================= -->
        <!--  SECTION 1: Focus Ring (Circular Progress) -->
        <!-- ========================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:baselineAligned="false">

                <!-- Circle 1: TOTAL FOCUS -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp">

                    <ProgressBar
                        android:id="@+id/progressFocusTime"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="145dp"
                        android:layout_height="145dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/circular_progress"
                        android:rotation="-90" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOTAL FOCUS"
                            android:textSize="9sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.15"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/tvTotalFocusTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0h 0m"
                            android:textSize="22sp"
                            android:textColor="@color/text_navy"
                            android:textStyle="bold" />

                    </LinearLayout>
                </FrameLayout>

                <!-- Circle 2: SCREEN TIME -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="145dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp">

                    <ProgressBar
                        android:id="@+id/progressScreenTimeRing"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="145dp"
                        android:layout_height="145dp"
                        android:layout_gravity="center"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/circular_progress_red"
                        android:rotation="-90" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SCREEN TIME"
                            android:textSize="9sp"
                            android:textColor="@color/text_secondary"
                            android:letterSpacing="0.15"
                            android:textStyle="bold"
                            android:layout_marginBottom="2dp" />

                        <TextView
                            android:id="@+id/tvTotalScreenTimeRing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0h 0m"
                            android:textSize="22sp"
                            android:textColor="@color/text_navy"
                            android:textStyle="bold" />

                    </LinearLayout>
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ========================================= -->
        <!--  SECTION 2: Stats Grid (2 columns)        -->
        <!-- ========================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:baselineAligned="false">

            <!-- Productive Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_light"
                android:padding="16dp"
                android:layout_marginEnd="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓"
                        android:textSize="14sp"
                        android:textColor="@color/primary_green"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRODUCTIVE"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.1"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvProductiveTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0h 0m"
                    android:textSize="22sp"
                    android:textColor="@color/text_navy"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvProductivePercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Focus Time"
                    android:textSize="12sp"
                    android:textColor="@color/primary_green"
                    android:layout_marginBottom="12dp" />

                <ProgressBar
                    android:id="@+id/progressProductive"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_blue" />

            </LinearLayout>

            <!-- Distraction Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/bg_card_light"
                android:padding="16dp"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠"
                        android:textSize="14sp"
                        android:textColor="@color/danger_red"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISTRACTION"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:letterSpacing="0.1"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDistractionTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 min"
                    android:textSize="22sp"
                    android:textColor="@color/text_navy"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvTimeLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ 30 min limit"
                    android:textSize="12sp"
                    android:textColor="@color/danger_red"
                    android:layout_marginBottom="12dp" />

                <ProgressBar
                    android:id="@+id/progressDistraction"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_red" />

            </LinearLayout>

        </LinearLayout>

        <!-- Insights Banner Button -->
        <Button
            android:id="@+id/btnViewInsights"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/soft_blue"
            android:text="📊 View Detailed App Insights & Pickups"
            android:textColor="@color/primary_blue"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:layout_marginBottom="16dp" />

        <!-- ========================================= -->
        <!--  SECTION 3: Daily Goal Progress           -->
        <!-- ========================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daily Goal Progress"
                    android:textSize="15sp"
                    android:textColor="@color/text_navy"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDailyGoalPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="14sp"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressDailyGoal"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_blue" />

            <TextView
                android:id="@+id/tvGoalMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ℹ Start monitoring to track your goal"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="10dp" />

        </LinearLayout>

        <!-- ========================================= -->
        <!--  SECTION 4: Hardware Sync                 -->
        <!-- ========================================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hardware Device Sync"
            android:textSize="17sp"
            android:textColor="@color/text_navy"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:paddingStart="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp">

                    <View
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_chip_soft_blue" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_lamp"
                        android:layout_gravity="center"
                        app:tint="@color/primary_blue" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESP32 Focus Lamp"
                        android:textSize="15sp"
                        android:textColor="@color/text_navy"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDeviceStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Device: Disconnected"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvConnectionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFLINE"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:background="@drawable/bg_chip_soft_blue"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>

            <EditText
                android:id="@+id/etIpAddress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_light"
                android:hint="Lamp IP Address (e.g. 192.168.4.1)"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_navy"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:inputType="text"
                android:layout_marginBottom="12dp"
                android:drawableStart="@drawable/ic_settings"
                android:drawablePadding="8dp"
                android:drawableTint="@color/text_secondary" />

            <Button
                android:id="@+id/btnSyncLamp"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="@color/primary_blue"
                android:text="⚡ Connect Focus Lamp"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- ========================================= -->
        <!--  SECTION 5: Monitoring Toggle             -->
        <!-- ========================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_light"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="16dp">

                <TextView
                    android:id="@+id/tvMonitoringStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Monitoring"
                    android:textSize="15sp"
                    android:textColor="@color/text_navy"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLimitWarning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap to start tracking screen time"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnToggleMonitoring"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:backgroundTint="@color/primary_green"
                android:text="Start"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:paddingHorizontal="24dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- ========================================= -->
        <!--  SECTION 6: Virtual Lamp Status           -->
        <!-- ========================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIRTUAL LAMP STATUS"
                android:textSize="10sp"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.15"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/viewLampGlow"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_chip_soft_green" />

                <TextView
                    android:id="@+id/tvLampIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="36sp"
                    android:layout_gravity="center" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvLampStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Within Limit"
                android:textSize="15sp"
                android:textColor="@color/primary_green"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- ========================================= -->
        <!--  SECTION 6b: Set Waste Time Limit         -->
        <!-- ========================================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_light"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily Screen Time Limit"
                android:textSize="15sp"
                android:textColor="@color/text_navy"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set max distraction time in minutes before lamp turns Red"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etWasteTimeLimit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_light"
                    android:hint="e.g. 30"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_navy"
                    android:textSize="16sp"
                    android:paddingHorizontal="16dp"
                    android:inputType="number"
                    android:layout_marginEnd="10dp" />

                <Button
                    android:id="@+id/btnSetLimit"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/primary_green"
                    android:text="Set Limit"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:paddingHorizontal="20dp"
                    android:stateListAnimator="@null" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCurrentLimit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current limit: 30 min"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- Start Focus Button -->
        <Button
            android:id="@+id/btnStartFocus"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/primary_blue"
            android:text="🎯  Start Focus Session"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:layout_marginBottom="16dp" />

        <!-- Sessions Count Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_light"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSIONS COMPLETED"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvCompletedSessions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textColor="@color/primary_green"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESP32 DEVICE IP"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvEspIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="192.168.4.1"
                    android:textSize="14sp"
                    android:textColor="@color/primary_blue"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
