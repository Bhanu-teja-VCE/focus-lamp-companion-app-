<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/bottom_bar_clearance">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding"
        android:paddingTop="8dp">

        <!-- Not linked yet -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/linkCard"
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/link_title" />

                <TextView
                    android:id="@+id/linkText"
                    style="@style/Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/link_text" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/codeLayout"
                    style="@style/Input.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/link_code_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/codeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="6" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/linkButton"
                    style="@style/Button.Paper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/link_button" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Linked -->
        <LinearLayout
            android:id="@+id/linkedSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView android:id="@+id/linkedTitle" style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <TextView android:id="@+id/linkedSub" style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
        </LinearLayout>

        <TextView
            style="@style/Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:text="@string/rules_from_parent" />

        <LinearLayout android:id="@+id/rulesList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <TextView
            android:id="@+id/rulesEmpty"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/no_parent_rules" />

        <TextView
            android:id="@+id/requestsHeading"
            style="@style/Text.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:text="@string/your_requests" />

        <LinearLayout android:id="@+id/requestsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <TextView
            android:id="@+id/requestsEmpty"
            style="@style/Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/no_requests" />

        <!-- No second phone: a parent edits rules here behind the PIN -->
        <LinearLayout
            android:id="@+id/localControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:orientation="vertical">

            <TextView style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/parent_controls_here" />
            <TextView style="@style/Text.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/parent_controls_here_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/openControls"
                style="@style/Button.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/open_parent_controls"
                app:icon="@drawable/ic_lock"
                app:iconTint="@color/paper" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/unlinkButton"
            style="@style/Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/unlink"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
