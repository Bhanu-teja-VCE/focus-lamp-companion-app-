<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <ImageView android:id="@+id/icon" android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="@null" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/name" style="@style/Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/reason" style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/open"
        style="@style/Button.Quiet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:text="@string/open_for_30" />
</LinearLayout>
